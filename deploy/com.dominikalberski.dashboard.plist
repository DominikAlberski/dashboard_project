<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dominikalberski.dashboard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/ruby</string>
		<string>--disable-gems</string>
		<string>/var/mobile/dashboard/bin/serve</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>AGENT_URL</key>
		<string>http://192.168.33.16:4567</string>
		<key>PORT</key>
		<string>8081</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/var/mobile/dashboard</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/var/mobile/dashboard/dashboard.log</string>
	<key>StandardErrorPath</key>
	<string>/var/mobile/dashboard/dashboard.log</string>
</dict>
</plist>
